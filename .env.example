# ── Twilio: browser softphone + inbound (docs/03-calling.md) ──────────────
# Works on a free trial (conference + queue routing, D18): trial can only call verified numbers.
# `npm run twilio:setup` fills TWILIO_TWIML_APP_SID and points the number at PUBLIC_BASE_URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Our Twilio number, E.164 (e.g. +14155550100): caller ID for outbound, rings the app inbound
TWILIO_PHONE_NUMBER=
# Exact public origin Twilio calls (ngrok URL in dev, production domain on Vercel). Used to verify signatures.
PUBLIC_BASE_URL=
# Where "Place call" on any sample lead actually rings (the demo phone), E.164
LEAD_CALL_NUMBER=
# Comma-separated E.164 numbers the dial pad may call. Anything else is refused.
DIAL_ALLOWLIST=
